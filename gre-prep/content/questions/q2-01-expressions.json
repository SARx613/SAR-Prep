  "type": "PS",
  "difficulty": 1,
  "stem": "Which of the following is equal to $3(2x-1)-4x$?",
  "content": {
   "format": "select_one",
   "choices": [
    {
     "id": "A",
     "text": "$2x-3$"
    },
    {
     "id": "B",
     "text": "$2x-1$"
    },
    {
     "id": "C",
     "text": "$2x+3$"
    },
    {
     "id": "D",
     "text": "$6x-3$"
    },
    {
     "id": "E",
     "text": "$10x-3$"
    }
   ]
  },
  "answer": {
   "choices": [
    "A"
   ]
  },
  "explanation": "Distribute: $6x-3$. Then subtract $4x$: $2x-3$.",
  "choiceExplanations": {
   "B": "The 3 was multiplied by $2x$ but not by $-1$.",
   "C": "Sign error: $3\\cdot(-1)$ is $-3$, not $+3$.",
   "D": "This stops after distributing and ignores the $-4x$.",
   "E": "The $4x$ was added instead of subtracted."
  },
  "estSeconds": 45,
