 {
  "id": "q2-01-expressions-07",
  "lessonId": "q2-01-expressions",
  "type": "PS",
  "difficulty": 3,
  "stem": "For all $x\\ne3$, which of the following is equal to $\\dfrac{x^2-9}{x^2-6x+9}$?",
  "content": {
   "format": "select_one",
   "choices": [
    {
     "id": "A",
     "text": "$\\dfrac{x-3}{x+3}$"
    },
    {
     "id": "B",
     "text": "$1$"
    },
    {
     "id": "C",
     "text": "$\\dfrac{x+3}{x-3}$"
    },
    {
     "id": "D",
     "text": "$\\dfrac{x}{x-6}$"
    },
    {
     "id": "E",
     "text": "$x+3$"
    }
   ]
  },
  "answer": {
   "choices": [
    "C"
   ]
  },
  "explanation": "Factor: numerator $(x-3)(x+3)$, denominator $(x-3)^2$. Cancel one factor $x-3$ to get $\\dfrac{x+3}{x-3}$.",
  "choiceExplanations": {
   "A": "Numerator and denominator are swapped.",
   "B": "This treats the denominator as $x^2-9$, ignoring the $-6x$.",
   "D": "This cancels the $-9$ against the $+9$, which are terms, not factors.",
   "E": "The denominator is $(x-3)^2$, so one factor $x-3$ remains below."
  },
  "estSeconds": 90,
  "skills": [
   "algebraic-expressions",
   "factoring"
  ],
