 {
  "id": "q2-01-expressions-04",
  "lessonId": "q2-01-expressions",
  "type": "PS",
  "difficulty": 2,
  "stem": "Which of the following are equal to $x^2-6x+9$? Indicate all such expressions.",
  "content": {
   "format": "select_all",
   "choices": [
    {
     "id": "A",
     "text": "$(x-3)^2$"
    },
    {
     "id": "B",
     "text": "$(x+3)^2$"
    },
    {
     "id": "C",
     "text": "$(3-x)^2$"
    },
    {
     "id": "D",
     "text": "$(x+3)(x-3)$"
    },
    {
     "id": "E",
     "text": "$x(x-6)+9$"
    }
   ]
  },
  "answer": {
   "choices": [
    "A",
    "C",
    "E"
   ]
  },
  "explanation": "$(x-3)^2=x^2-6x+9$. Since $(3-x)^2=(x-3)^2$, that works too. And $x(x-6)+9=x^2-6x+9$.",
  "choiceExplanations": {
   "B": "$(x+3)^2=x^2+6x+9$: the middle sign is wrong.",
   "D": "$(x+3)(x-3)=x^2-9$: no middle term."
  },
  "estSeconds": 75,
  "skills": [
   "algebraic-expressions",
   "factoring"
  ],
  "review": {
   "status": "draft",
   "solvedBy": [],
   "sourceChecked": false
  }
 },
