 {
  "id": "q1-27-associative-identity-laws-06",
  "lessonId": "q1-27-associative-identity-laws",
  "difficulty": 3,
  "stem": "For all real numbers $r$, $s$ and $t$ (with no denominator equal to 0), which of the following is always true?",
  "explanation": "Only addition (and multiplication) is associative: $r+(s+t)=(r+s)+t$.",
  "choiceExplanations": {
   "A": "Fails for $r=s=t=1$: $-1\\ne1$.",
   "B": "Fails for $r=s=t=2$: $\\tfrac12\\ne2$.",
   "D": "Fails unless $r=s$: subtraction is not commutative.",
   "E": "Fails unless $r=\\pm s$: division is not commutative."
  },
  "estSeconds": 75,
  "skills": [
   "associative"
  ],
  "topics": [],
  "review": {
   "status": "draft",
   "solvedBy": [],
   "sourceChecked": false
  },
  "type": "PS",
  "content": {
   "format": "select_one",
   "choices": [
    {
     "id": "A",
     "text": "$(r-s)-t=r-(s-t)$"
    },
    {
     "id": "B",
     "text": "$(r\\div s)\\div t=r\\div(s\\div t)$"
    },
    {
     "id": "C",
     "text": "$r+(s+t)=(r+s)+t$"
    },
    {
     "id": "D",
     "text": "$r-s=s-r$"
    },
    {
     "id": "E",
     "text": "$r\\div s=s\\div r$"
    }
   ]
  },
  "answer": {
   "choices": [
    "C"
   ]
  }
 },
