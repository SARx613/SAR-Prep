     "id": "A",
     "text": "None"
    },
    {
     "id": "B",
     "text": "One"
    },
    {
     "id": "C",
     "text": "Two"
    },
    {
     "id": "D",
     "text": "Three"
    },
    {
     "id": "E",
     "text": "Infinitely many"
    }
   ]
  },
  "answer": {
   "choices": [
    "A"
   ]
  },
  "explanation": "$f(2x)=6x-4$ and $2f(x)=6x-8$. Setting them equal gives $-4=-8$, which is false for every $x$.",
  "choiceExplanations": {
