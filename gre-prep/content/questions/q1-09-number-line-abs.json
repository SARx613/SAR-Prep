 {
  "id": "q1-09-number-line-abs-11",
  "lessonId": "q1-09-number-line-abs",
  "type": "PS",
  "difficulty": 5,
  "stem": "The real numbers $x$ and $y$ satisfy $x<0<y$ and $|x|>|y|$. Which of the following must be positive?",
  "content": {
   "format": "select_one",
   "choices": [
    {
     "id": "A",
     "text": "$x+y$"
    },
    {
     "id": "B",
     "text": "$x-y$"
    },
    {
     "id": "C",
     "text": "$xy$"
    },
    {
     "id": "D",
     "text": "$|y|-|x|$"
    },
    {
     "id": "E",
     "text": "$y-x$"
    }
   ]
  },
  "answer": {
   "choices": [
    "E"
   ]
  },
  "explanation": "$y-x = y+|x|$ is the sum of two positive numbers, so it is positive. The others are negative: $x+y<0$ since $x$ is farther from 0 than $y$; $x-y$ is negative minus positive; $xy$ is negative times positive; $|y|-|x|<0$ because $|x|>|y|$.",
  "choiceExplanations": {
   "A": "$|x|>|y|$ makes the negative number dominate: the sum is negative.",
   "B": "Subtracting a positive from a negative stays negative.",
   "C": "A negative times a positive is negative.",
   "D": "$|x|>|y|$ means $|y|-|x|<0$."
  },
  "estSeconds": 100,
  "skills": [
   "number-line-abs"
  ],
  "review": {
   "status": "draft",
   "solvedBy": [],
   "sourceChecked": false
  }
 },
 {
